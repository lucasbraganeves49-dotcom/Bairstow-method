import cmath

raizes=[] #lista em q serao colocadas as raizes
r=1
s=1
tol= 1e-4
max_iter= 1000 #limite de iteracoes
coeficientesb=[] #lista em q serao colocadas os b
coeficientesc=[] #lista em q serao colocadas os c

#é necessário determinar os valores de b e c
def bairstow(coeficientes):
    bn= coeficientes[0]
    bn1=coeficientes[1]+r*bn
    k = n-2
    j = 0
    coeficientesb.append(bn)
    coeficientesb.append(bn1)
    while k>=0:
        bi= coeficientes[2+j] + r*coeficientesb[1+j] + s*coeficientesb[j]
        coeficientesb.append(bi)
        j= j+1
        k=k-1
    
    cn = coeficientesb[0]
    cn1 = coeficientesb[1] + r*cn
    l= n - 2
    m= 0
    coeficientesc.append(cn)
    coeficientesc.append(cn1)
    while l>=1:
        ci =  coeficientesb[2+m] + r*coeficientesc[1+m] + s*coeficientesc[m]
        coeficientesc.append(ci)
        m= m+1
        l=l-1

 #Regra de cramer para resolver um sistema 2x2   
def cramer(listab, listac):
    #C2 dr +C3 ds = -B1
    #C1 dr + C2 ds = -B0
    c1= coeficientesc[-1]
    c2= coeficientesc[-2]
    c3= coeficientesc[-3]
    b1= coeficientesb[-2]
    b0= coeficientesb[-1]
    #primeiro determinar dr
    dr= (-b1*c2-(-b0*c3)) / (c2*c2 - (c3*c1))
    #determinando ds
    ds= (c2*-b0-(-b1*c1))/ (c2*c2 - (c3*c1))
    return dr, ds

#criterio de convergencia, será usado para garantir que dr e ds sejam pequenos o suficiente. Esse critério resolve o bug nos casos em que r=0 ou s=0
def convergiu(dr, ds, r, s, tol):
    err_r = abs(dr) if r == 0 else abs(dr / r)
    err_s = abs(ds) if s == 0 else abs(ds / s)
    return err_r * 100 <= tol and err_s * 100 <= tol

